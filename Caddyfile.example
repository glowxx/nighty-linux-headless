# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL production front for nighty-linux-headless.
#
# The bundled bridge (scripts/bridge.py) already tunnels Nighty's socket.io
# WebSockets reliably (select()-based, TCP_NODELAY, keepalive), so you do NOT
# need this for stable real-time over a plain LAN.
#
# Reach for Caddy when you want extras the bridge doesn't do: TLS/HTTPS in one
# line, HTTP/2, gzip, or fronting a high-traffic / internet-exposed deployment.
# Caddy proxies HTTP *and* WebSockets natively.
#
# Usage:
#   1) Install Caddy (https://caddyserver.com/docs/install).
#   2) Set BRIDGE_HOST=127.0.0.1, BRIDGE_PORT=8089, BRIDGE_AUTH=on in .env
#      and restart Nighty. Forced auth protects requests arriving from Caddy.
#   3) Copy this to /etc/caddy/Caddyfile (edit the address/port as you like).
#   4) systemctl reload caddy
#   5) Open http://<host-ip>:8088/ in your browser.
#
# This uses the bridge for onboarding, HTTP auth and WebSocket restrictions.
# Caddy forwards the browser's Authorization header to the bridge by default.
# Use a hostname with HTTPS before exposing this outside a trusted LAN.
# ─────────────────────────────────────────────────────────────────────────────

:8088 {
	# Authenticated bridge (loopback). Caddy upgrades WebSockets automatically.
	reverse_proxy 127.0.0.1:8089

	encode gzip
}

# ── Want HTTPS on your LAN? Use a hostname + Caddy's internal CA: ──
# nighty.lan {
# 	tls internal
# 	reverse_proxy 127.0.0.1:8089
# }
