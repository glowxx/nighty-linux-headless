# NOTE: You normally do NOT need to write this file yourself.
# Running `bash scripts/run.sh` and choosing "2) autostart" installs and
# enables exactly this unit for you (with the right user and paths filled in).
#
# This template is here only for reference / manual installation. If you do it
# by hand, replace <USER> and <REPO_DIR> with your values, copy it to
# /etc/systemd/system/nighty.service, then:
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now nighty
#
# run.sh brings up the WHOLE stack (Xvfb + config enforcement + Web UI bridge +
# Nighty backend) and keeps each part alive, so a single service is enough.

[Unit]
Description=Nighty headless (backend + Web UI bridge)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=<USER>
WorkingDirectory=<REPO_DIR>
ExecStart=/usr/bin/env bash <REPO_DIR>/scripts/run.sh --run
Restart=always
RestartSec=5
SuccessExitStatus=23
RestartPreventExitStatus=23
# Kill the whole cgroup on stop (this is the systemd default; stated explicitly
# because the stack is a tree of Xvfb + bridge + wine + backend processes).
KillMode=control-group
# OOM backstop: if the stack's memory climbs, let the kernel OOM-kill the cgroup
# so Restart=always brings it back cleanly, rather than the host thrashing.
# NOTE: the "%" form needs systemd v240+ AND the unified cgroup v2 hierarchy
# (default on current distros). On older systemd it is ignored (logged, unit
# still starts); on a cgroup-v1 host it may not be enforced. Use an absolute
# value (e.g. MemoryMax=2G) if your host predates that.
MemoryMax=90%

[Install]
WantedBy=multi-user.target
