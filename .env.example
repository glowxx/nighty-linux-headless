# ════════════════════════════════════════════════════════════
#  nighty-linux-headless — configuration
#  Copy to ".env" and fill in.  NEVER commit your real .env.
# ════════════════════════════════════════════════════════════

# ── Your Nighty binary (bring your own — it is NOT redistributed) ──
# Put your original Nighty.exe next to this file, then run scripts/install.sh.
NIGHTY_EXE=./Nighty.exe
NIGHTY_STUB=./Nighty_stub.exe

# ── Runtime locations ──
# scripts/install.sh fills these in for you (resolved, absolute). Defaults below
# are used if you run things manually without the installer.
NIGHTY_HOME=
WINEPREFIX=
# Wine username inside the prefix (drive_c/users/<name>). Leave empty to auto-detect.
WINEUSER=
# Wine launcher binary. On x86-64 this is your distro's "wine64". On non-x86 the
# installer points this at a static x86-64 Wine build that runs under Box64.
WINE_BIN=wine64
# Wine DLL overrides. Default disables the headless-unfriendly components
# (.NET / Internet Explorer / desktop integration) that otherwise crash the
# backend on a fresh prefix. Only change this if you know you need one of them.
# WINEDLLOVERRIDES=mscoree=d;mshtml=d;winemenubuilder.exe=d

# ── Web UI credentials (YOU choose these) ──
WEBUI_USERNAME=admin
WEBUI_PASSWORD=change-this-please

# ── Native Web UI bind (loopback only; the LAN bridge exposes it safely) ──
WEBUI_HOST=127.0.0.1
WEBUI_PORT=8090

# ── LAN bridge (this is the address you open in a browser) ──
BRIDGE_HOST=0.0.0.0
BRIDGE_PORT=8088

# ── Internal stub control server (loopback only — do not expose) ──
STUB_PORT=8765

# ── Headless virtual display ──
DISPLAY_NUM=99
XVFB_TIMEOUT=10

# Single-instance protection. Keep enabled in normal use. A second run prints
# the existing panel URL and exits without killing or replacing the live stack.
# Set to "off" only as a temporary rollback.
NIGHTY_SINGLE_INSTANCE=enforce
# Optional custom lock path. Empty uses $NIGHTY_HOME/run.lock.
NIGHTY_INSTANCE_LOCK=

# ── Backend boot watchdog ──
# Seconds to wait for Nighty's stub control server (STUB_PORT) to answer after a
# Wine launch before assuming the boot hung and killing + retrying it. Some Wine
# builds stall during first-prefix init with no error. Raise this on very slow
# hardware if a genuinely slow boot is being cut short; lower it for faster retries.
BOOT_TIMEOUT=300
# Additional seconds allowed after the stub appears for the real Web UI to open.
# If Discord/Cloudflare fails during boot, the backend is retried instead of
# leaving the loading screen forever.
WEBUI_BOOT_TIMEOUT=180

BACKEND_FAST_FAIL_SECONDS=60
BACKEND_MAX_BACKOFF=300
BACKEND_TRIAGE_AFTER=3

NIGHTY_INIT_SYSTEM=

# PyInstaller extracts Nighty_stub.exe into _MEI* directories in the Wine Temp
# folder. run.sh removes leftovers after abnormal exits and before a new launch.
# Set to 0 only as a temporary rollback if cleanup must be disabled.
CLEAN_STALE_MEI=1
# To inspect old leftovers manually while Nighty is stopped:
#   WINEPREFIX=/path/to/prefix bash scripts/cleanup_mei.sh --dry-run

# ── Hard enforcement: keep Web UI ALWAYS on (1 = enabled) ──
# If Nighty or the user disables Web UI, it is forced back on.
ENFORCE_WEBUI=1
ENFORCE_INTERVAL=5
# How often (seconds) to poll Nighty's LIVE profile state to stop a crash-prone
# RPC preset a user started by hand. This is the only enforcement step that calls
# into Nighty's main thread, so on an emulated backend (Box64) a small value steals
# CPU from the bot's event loop and can cause "heartbeat blocked" / missed command
# responses. On-disk auto-start protection runs every ENFORCE_INTERVAL regardless;
# this only bounds how fast a manually-started RPC preset is stopped. Raise it if
# you still see heartbeat warnings; lower it only on native x86 (no emulation).
RP_GUARD_INTERVAL=30

# ── Box64 performance/safety profile (ARM only) ──
# safe: the original maximum-compatibility profile (slow, rollback option).
# balanced: faster main Wine/Python execution while config/box64-nighty.rc keeps
# the crash-prone tls-client DLL on strict settings.
# performance: maximum speed with aggressive Dynarec flags. Native x86 ignores this.
NIGHTY_BOX64_PROFILE=safe
# Bridge state checks read only this many bytes from the tail of backend.log.
BACKEND_LOG_SCAN_BYTES=4194304

# ── Performance: blackhole the RP fetch hosts (lyrics + Spotify) ──
# Nighty's Rich-Presence task makes BLOCKING calls (lrclib.net lyrics, api.spotify.com
# now-playing) that, under emulation, can freeze the whole bot for seconds — commands
# then fail with "the application did not respond" and the gateway heartbeat times out.
# 1 = point those hosts at a dead address (set up by install.sh) so the calls fail
# instantly. Pointless on a headless box; set 0 only on native x86 if you want them.
BLOCK_LRCLIB=1

# ── Performance: cap Nighty's user-history tracker ──
# Nighty rewrites data/misc/user_history.json IN FULL on the event loop whenever a
# tracked user changes name/avatar. Unbounded it grows to many MB and the whole-file
# write then blocks the bot (heartbeat timeouts / missed command responses). We prune
# it to this many bytes before each launch (keeping the most-recent users). Raise it
# to keep more history at the cost of longer writes; there is no way to disable the
# tracker in Nighty itself.
USER_HISTORY_MAX_BYTES=524288

# Bridge authentication. 'auto' (default) requires HTTP Basic auth with
# WEBUI_USERNAME / WEBUI_PASSWORD whenever BRIDGE_HOST is not loopback.
# 'on' always requires it; 'off' disables it. Loopback clients (the Docker
# healthcheck, run.sh probes) are always exempt.
BRIDGE_AUTH=auto
# Largest request body the bridge will read, in bytes.
BRIDGE_MAX_REQUEST_BYTES=262144
# Maximum webview events the stub retains (0 = unbounded).
NIGHTY_STUB_EVENT_CAP=2000
